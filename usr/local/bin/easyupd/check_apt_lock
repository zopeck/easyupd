# NOTA MUY IMPORTANTE!:
# El comando FUSER, devuelve "1" si su ocupacion es "falsa", por el contrario
# devuelve "0" cuando el sistema de paquetes esta siendo utilizado por el
# sistema y por lo tanto, bloqueado, por lo que el sistema no nos va a dejar
# correr el "EasyUpd"

check_apt_lock() {
    # fuser devuelve 0 si AL MENOS UN archivo está bloqueado (APT ocupado)
    if fuser /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then
        # Solo imprimimos mensajes si estamos en una terminal interactiva (stdout es un TTY)
        if [ -t 1 ]; then
            echo -e "${red:-}[!] Error: El sistema de gestión de paquetes está siendo usado por otro programa.${nc:-}"
            echo -e "${yellow:-}Por favor, cierra otras aplicaciones de software e intenta de nuevo.${nc:-}"
        fi
        return 1 # Indica que SÍ hay bloqueo (fallo para el caller)
    fi

    return 0 # Indica que el sistema de paquetes está libre
}
